# Browser-safe values from Supabase Dashboard → Connect.
# VITE_* values are bundled into frontend JavaScript. Never put a secret or
# service-role key in this file or in Cloudflare Pages environment variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
